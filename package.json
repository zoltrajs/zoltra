{
  "name": "zoltra",
  "version": "0.1.0",
  "description": "A fast, file-based JavaScript web server framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "zoltra",
    "web-server",
    "backend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoltrajs/zoltra.git"
  },
  "homepage": "https://github.com/zoltrajs/zoltra#readme",
  "bugs": {
    "url": "https://github.com/zoltrajs/zoltra/issues"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@zoltra/cli-builder": "^0.1.1",
    "chokidar": "^4.0.3"
  },
  "bin": {
    "zoltra": "./dist/cli/index.js"
  }
}
