{
  "name": "zoltra",
  "version": "0.1.0-next.6.4",
  "description": "A fast, file-based JavaScript web server framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": { 
    "tag": "next"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "license": "MIT",
  "keywords": [
    "zoltra",
    "web-server",
    "backend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoltrajs/zoltra/tree/next"
  },
  "homepage": "https://github.com/zoltrajs/zoltra/tree/next#readme",
  "bugs": {
    "url": "https://github.com/zoltrajs/zoltra/tree/nextissues"
  },
  "scripts": {
    "build": "tsup",
    "publish:next": "npm publish --provenance=false --access public --tag next",
    "publish:rc": "npm publish --provenance=false --access public --tag rc",
    "publish": "npm publish --provenance=false --access public --tag latest"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/fs-extra": "^11.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@zoltra/cli-builder": "^0.1.2",
    "chokidar": "^4.0.3",
    "compression": "^1.8.1",
    "download-git-repo": "^3.0.2",
    "fs-extra": "^11.3.1",
    "mime-types": "^3.0.1",
    "ora": "^8.2.0",
    "path-to-regexp": "^8.3.0",
    "ws": "^8.18.3"
  },
  "bin": {
    "zoltra": "./dist/cli/index.js"
  }
}
